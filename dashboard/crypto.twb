            <column caption='Dynamic Metric Value' datatype='real' name='[Calculation_0724317198716932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0724317198327811]&#13;&#10;  WHEN &quot;Current Price&quot; THEN AVG([CURRENT_PRICE])&#13;&#10;  WHEN &quot;Total Volume&quot; THEN AVG([TOTAL_VOLUME])&#13;&#10;  WHEN &quot;Market Cap&quot; THEN AVG([MARKET_CAP])&#13;&#10;END' />

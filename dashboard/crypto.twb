      <column caption='Calendar Year' datatype='integer' name='[CALENDAR_YEAR]' role='dimension' type='quantitative' />
      <column caption='Collected At' datatype='datetime' name='[COLLECTED_AT]' role='dimension' type='ordinal' />
      <column caption='Crypto Id (Dim Cryptocurrency)' datatype='string' name='[CRYPTO_ID (DIM_CRYPTOCURRENCY)]' role='dimension' type='nominal' />
      <column caption='Crypto Id' datatype='string' name='[CRYPTO_ID]' role='dimension' type='nominal' />
      <column caption='Current Price' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[CURRENT_PRICE]' role='measure' type='quantitative' />
      <column caption='7-Day Price Var (%)' datatype='real' default-format='p0.00%' name='[Calculation_0724317174181888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([CURRENT_PRICE]) - LOOKUP(SUM([CURRENT_PRICE]), -7)) &#13;&#10;/ &#13;&#10;LOOKUP(SUM([CURRENT_PRICE]), -7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Volume to Market Cap Ratio' datatype='real' name='[Calculation_0724317180817409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TOTAL_VOLUME]) / SUM([MARKET_CAP])' />
      </column>
      <column caption='Relative Performance (%)' datatype='real' default-format='p0.00%' name='[Calculation_0724317180915714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([CURRENT_PRICE]) - LOOKUP(SUM([CURRENT_PRICE]), FIRST())) &#13;&#10;/ &#13;&#10;LOOKUP(SUM([CURRENT_PRICE]), FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic Metric Value' datatype='real' name='[Calculation_0724317198716932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0724317198327811]&#13;&#10;  WHEN &quot;Current Price&quot; THEN AVG([CURRENT_PRICE])&#13;&#10;  WHEN &quot;Total Volume&quot; THEN AVG([TOTAL_VOLUME])&#13;&#10;  WHEN &quot;Market Cap&quot; THEN AVG([MARKET_CAP])&#13;&#10;END' />
      </column>
